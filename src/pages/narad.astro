---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { readingTimeMins, candleRead } from '../lib/reading';
import { monthYear } from '../lib/dates';

// The build saga, in reading order, pulled live so titles/dates stay in sync
const QUEST_CHAIN = [
  'tech/accidentally-rediscovering-kafka',
  'tech/notes-from-inside-the-crab',
  'tech/the-crab-ships',
  'tech/the-crab-molts',
  'tech/the-crab-and-the-giants',
  'tech/the-crab-crosses-the-sea',
  'tech/the-crab-grows-up',
  'tech/everything-the-crab-can-do',
];
const NUMERALS = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const saga = QUEST_CHAIN
  .map(id => allPosts.find(p => p.id === id))
  .filter(post => post !== undefined)
  .map(post => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    readingTime: readingTimeMins(post.body),
  }));

const enchantments = [
  { name: 'Durable before acknowledged', desc: 'A 202 means the message is fsynced to disk, not buffered, not "probably". Crash a millisecond later; it survives.' },
  { name: 'Built to say yes', desc: 'Availability first: any live node accepts your produce and routes around dead partition owners. Machines burn; messages land.' },
  { name: 'No consumer groups', desc: 'No rebalancing storms, no generation IDs. Scale consumers by starting more consumers; that’s the whole runbook.' },
  { name: 'Plain HTTP, any language', desc: 'The whole API is HTTP, described by an OpenAPI spec. There’s a Go client if you want one; curl works if you don’t.' },
  { name: 'Batches when you need speed', desc: 'Send up to 1,000 messages in one request, read and ack up to 100. One disk flush carries the whole batch.' },
  { name: 'One topic, many copies', desc: 'Attach child topics and every message is copied to each: right away, after a fixed delay, or onto other servers as a replica.' },
  { name: 'Copies across clusters', desc: 'A remote child copies a topic to another Narad cluster as messages arrive: offload a busy topic, or keep a recovery copy in another region.' },
  { name: 'Schemas at the door', desc: 'Give a topic a JSON Schema and a bad message gets a 400 naming the field. Nothing malformed ever reaches the log.' },
  { name: 'Grows and shrinks under load', desc: 'Add servers, rebalance partitions, or drain a node before removing it, without pausing producers or losing a message.' },
  { name: 'Least privilege', desc: 'Give each service its own user with only the grants it needs, like produce on orders-*. Every change is written to an audit log.' },
  { name: 'Nothing hidden', desc: 'Prometheus metrics for everything, ready-made alerts for what really goes wrong, and a troubleshooting guide that starts from the symptom.' },
  { name: 'One binary, one Helm chart', desc: 'Raft lives inside the same binary. No ZooKeeper, no keeper of any kind. If you can run a StatefulSet, you can run Narad.' },
];

const receipts = [
  { value: '376k/s', label: 'messages in batches of 100 on three nodes, sustained through send, read and ack' },
  { value: '135M', label: 'messages in that run, each one checked off; none missing' },
  { value: '0', label: 'messages lost across every chaos run: leader kills, all-node kills, network splits' },
  { value: '10.5k/s', label: 'sends on a single 2-CPU node, one message per request, up from 5.6k in August' },
  { value: '300M+', label: 'messages soaked through the 1.0 release on a live five-node cluster' },
  { value: '44.8M', label: 'messages in the September soak, none left undelivered' },
  { value: '101', label: 'confirmed problems fixed from two code audits of the busy path and the control plane' },
  { value: 'Passing', label: 'OpenSSF Best Practices badge, with security reporting, testing and release rules' },
];
---

<BaseLayout title="Narad" description="Narad: a message broker in one Go binary. Plain HTTP in, at-least-once out, with batches, child topics and cross-cluster copies. Proven with soaks, chaos runs and audits.">
  <article>
    <header class="mb-8">
      <p class="ui-label" style="font-size:0.75rem; margin-bottom:0.5rem;">Notable Deed</p>
      <div class="artifact-heading">
        <svg class="narad-mark" viewBox="0 0 16 16" role="img" aria-label="The Narad mark">
          <path class="narad-mark-bar" d="M1 1H4L8 7H5L3 4V15H1Z"/>
          <path class="narad-mark-msg" d="M7 10H10L12 13H9Z"/>
          <path class="narad-mark-bar" d="M13 1H15V15H13Z"/>
        </svg>
        <h1 class="artifact-title">Narad</h1>
      </div>
      <p class="artifact-tagline">A message broker in one Go binary.</p>
      <p class="artifact-lead">
        A message broker that respects your weekend: plain HTTP in, at-least-once out, and
        nothing to babysit in between. Built to learn distributed systems properly, then soaked,
        crashed, audited, and drilled until the evidence caught up with the design.
        v1.0 shipped in July 2026, rebalancing arrived in 2.0, and Narad 3 added batches and
        copies across clusters. It’s on v3.2.2 now; the forge is still lit.
      </p>

      <div class="artifact-actions">
        <a href="https://github.com/DebanganThakuria/narad" target="_blank" rel="noopener noreferrer" class="artifact-btn">View the code ↗</a>
        <a href="https://debanganthakuria.github.io/narad/" target="_blank" rel="noopener noreferrer" class="artifact-btn artifact-btn-secondary">Read the docs ↗</a>
      </div>
    </header>

    <hr class="rule-diamond" />

    <section class="mt-8">
      <h2 class="ui-label section-heading">Enchantments</h2>
      <div class="ench-grid">
        {enchantments.map(e => (
          <div class="ench-item">
            <span class="ench-diamond" aria-hidden="true"></span>
            <div>
              <p class="ench-name">{e.name}</p>
              <p class="ench-desc">{e.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="rule-diamond" />

    <section class="mt-8">
      <h2 class="ui-label section-heading">Proven in the Field</h2>
      <div class="receipt-grid">
        {receipts.map(r => (
          <div class="receipt-card torn">
            <p class="receipt-value">{r.value}</p>
            <p class="receipt-label">{r.label}</p>
          </div>
        ))}
      </div>
      <p class="receipt-note">
        Plus a remote child that copied 320,211 records to another cluster in about six seconds and
        lost nothing through node kills, a dead target cluster and a 60-second network split; a
        linearizability checker that ties every redelivery to a fault; a chaos matrix of
        <code>kill -9</code>s and mid-write restarts; and rolling upgrades with written rollback
        rules, all against a real Kubernetes deployment, not a laptop.
      </p>
    </section>

    <section class="fine-print">
      <h2 class="ui-label section-heading">The Honest Fine Print</h2>
      <p>
        Narad stays small on purpose. Ordering is not guaranteed (carry a sequence in the payload if
        you need one). Each partition is stored once, so a lost disk loses what’s on it unless you
        keep a replica child or volume snapshots. There’s no retry engine, dead-letter queue, message
        headers or duplicate detection in the broker; you build those from topics, leases and acks,
        and the docs show how. Client TLS ends at your ingress. The docs say all of this in bold,
        not in a footnote.
      </p>
    </section>

    <hr class="rule-diamond" />

    <section class="mt-8">
      <h2 class="ui-label section-heading">The Quest Chain</h2>
      <p class="chain-intro">The build is chronicled in {saga.length} journal entries, from the first sketch to Narad 3:</p>
      <div class="flex flex-col gap-3">
        {saga.map((post, i) => (
          <a href={`/posts/${post.id}`} class="chain-entry torn">
            <span class="chain-num">{NUMERALS[i]}</span>
            <span class="chain-body">
              <span class="chain-title">{post.title}</span>
              <span class="chain-meta">{candleRead(post.readingTime)} · {monthYear(post.date)}</span>
            </span>
            <span class="chain-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .artifact-heading {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .artifact-heading .artifact-title { margin-bottom: 0; }

  .narad-mark {
    width: 2.6rem;
    height: 2.6rem;
    flex-shrink: 0;
  }

  .narad-mark-bar { fill: var(--color-text); }
  .narad-mark-msg { fill: #528A00; }
  :global(html.dark) .narad-mark-msg { fill: #B8F53A; }

  .artifact-title {
    font-family: var(--font-family-heading);
    font-size: 3rem;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }

  .artifact-tagline {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--color-coral);
    margin-bottom: 1rem;
  }

  .artifact-lead {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text);
    max-width: 62ch;
    margin-bottom: 1.5rem;
  }

  .artifact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .artifact-btn {
    font-family: var(--font-family-heading);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.5rem 1.1rem;
    background: var(--color-coral);
    color: var(--color-parchment);
    border: 1px solid var(--color-coral);
    text-decoration: none;
    transition: transform 0.12s ease, opacity 0.12s ease;
  }

  .artifact-btn:hover { transform: translateY(-2px); opacity: 0.92; }

  .artifact-btn-secondary {
    background: var(--color-parchment-deep);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .section-heading {
    font-size: 0.85rem;
    margin-bottom: 1.1rem;
  }

  /* Enchantments */
  .ench-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem 2rem;
  }

  .ench-item {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
  }

  .ench-diamond {
    width: 8px;
    height: 8px;
    margin-top: 0.5rem;
    transform: rotate(45deg);
    background: var(--color-gold-bright);
    border: 1px solid var(--color-gold);
    flex-shrink: 0;
  }

  .ench-name {
    font-family: var(--font-family-heading);
    font-size: 1.05rem;
    color: var(--color-text);
    margin-bottom: 0.15rem;
  }

  .ench-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 700px) {
    .ench-grid { grid-template-columns: 1fr; }
  }

  /* Receipts */
  .receipt-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .receipt-card {
    padding: 1rem 1.1rem;
    background: var(--color-parchment-deep);
    border: 1px solid var(--color-border);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-parchment) 55%, transparent);
  }

  .receipt-value {
    font-family: var(--font-family-heading);
    font-size: 1.9rem;
    color: var(--color-coral);
    line-height: 1.1;
    margin-bottom: 0.3rem;
  }

  .receipt-label {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .receipt-note {
    margin-top: 1rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .receipt-note code {
    font-family: var(--font-family-mono);
    font-size: 0.8em;
    background: var(--color-parchment-deep);
    border: 1px solid var(--color-border);
    padding: 0.1em 0.35em;
  }

  @media (max-width: 800px) {
    .receipt-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* Fine print */
  .fine-print {
    margin-top: 2rem;
    padding: 1.1rem 1.3rem;
    border-left: 4px double var(--color-gold);
  }

  .fine-print p {
    font-size: 0.98rem;
    font-style: italic;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* Quest chain */
  .chain-intro {
    font-size: 0.98rem;
    font-style: italic;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .chain-entry {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.2rem;
    background: var(--color-parchment-deep);
    border: 1px solid var(--color-border);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-parchment) 55%, transparent);
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .chain-entry:hover {
    transform: translateX(5px);
    border-color: var(--color-coral);
  }

  .chain-num {
    font-family: var(--font-family-heading);
    font-size: 1.3rem;
    color: var(--color-gold);
    width: 2rem;
    text-align: center;
    flex-shrink: 0;
  }

  .chain-body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }

  .chain-title {
    font-family: var(--font-family-heading);
    font-size: 1.1rem;
    color: var(--color-text);
    line-height: 1.35;
  }

  .chain-meta {
    font-size: 0.82rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .chain-arrow {
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .chain-entry:hover .chain-arrow {
    color: var(--color-coral);
    transform: translateX(3px);
  }
</style>
